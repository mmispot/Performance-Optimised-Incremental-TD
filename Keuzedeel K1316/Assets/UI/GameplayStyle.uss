.root {
    flex-direction: row;
    flex-grow: 1;
    height: 100%;
    justify-content: space-between;
    align-items: center;
}

.inventory {
    background-color: orange;
    color: black;
    width: 17%;
    height: 75%;
    max-height: 90%;
    border-width: 20px;
    justify-content: center;
}

.item-buttons {
    margin: 5px;
}

.content .wider {
    width: 50%;
}

.content .unity-scroll-view__content-container {
    background-color: yellow;
    color: black;
    padding: 10px;
    max-width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
}

.button:hover {
    background-color: white;
    color: red;
}

.menu {
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    width: 10%;
}


